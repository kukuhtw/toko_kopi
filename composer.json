{
  "name": "kukuhtw/toko-kopi",
  "description": "KopiBot AI Agent Commerce Platform built with PHP Native, MySQL, LLM AI, chatbot order flow, CRM, loyalty, payment, delivery, and plugin system.",
  "type": "project",
  "license": "proprietary",
  "authors": [
    {
      "name": "Kukuh TW",
      "email": "kukuhtw@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "vlucas/phpdotenv": "^5.6",
    "guzzlehttp/guzzle": "^7.9",
    "monolog/monolog": "^3.7",
    "firebase/php-jwt": "^6.10"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.12",
    "friendsofphp/php-cs-fixer": "^3.64"
  },
  "autoload": {
    "psr-4": {
      "KopiBot\\": "src/",
      "KopiBot\\Plugins\\": "plugins/"
    },
    "files": [
      "config/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "KopiBot\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "migrate": "php migrate.php",
    "migrate:public-index": "php scripts/migrate-public-index-runtime.php",
    "migrate:customer-crm": "php scripts/migrate-customer-crm-composer.php",
    "serve": "php -S localhost:8000 -t public",
    "smoke:core": "php tests/smoke_core.php",
    "smoke:auth": "php tests/smoke_auth.php",
    "smoke:chatbot": "php tests/smoke_chatbot.php",
    "smoke:migration": "php tests/smoke_migration_bridge.php",
    "smoke:plugin": "php tests/smoke_plugin_loader.php",
    "smoke:payment": "php tests/smoke_payment_factory.php",
    "smoke:api": "php tests/smoke_api.php",
    "smoke:all": [
      "@smoke:core",
      "@smoke:auth",
      "@smoke:chatbot",
      "@smoke:migration",
      "@smoke:plugin",
      "@smoke:payment",
      "@smoke:api"
    ],
    "integration:checkout": "php tests/integration_checkout.php",
    "integration:chat-memory": "php tests/integration_chat_memory.php",
    "integration:all": [
      "@integration:checkout",
      "@integration:chat-memory"
    ],
    "verify": [
      "@smoke:all",
      "@integration:all"
    ],
    "test": "phpunit",
    "analyse": "phpstan analyse src plugins",
    "cs-fix": "php-cs-fixer fix"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
